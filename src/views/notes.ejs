<%- include('partials/header', { activePage: 'notes' }) %>

<div style="margin-bottom: 1.5rem;">
  <h2 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 800;">Class Notes & Study Materials</h2>
  <p style="color: var(--text-secondary); margin-top: 0.15rem; font-size: 0.875rem;">Collaborative repository for course notes, lecture summaries, and study guides.</p>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="grid-3" style="margin-bottom: 2rem;">
  <!-- Post Note Form -->
  <div class="card-light">
    <div class="card-title-row">
      <h3>📝 Share a New Study Note</h3>
    </div>

    <form action="/notes/create" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label">Note Title</label>
        <input type="text" name="title" class="form-input" placeholder="e.g. CS401 Web Security Summary" required>
      </div>

      <div class="form-group">
        <label class="form-label">Course / Subject Code</label>
        <input type="text" name="subject" class="form-input" placeholder="CS401" required>
      </div>

      <div class="form-group">
        <label class="form-label">Note Content (HTML Enabled)</label>
        <textarea name="content" class="form-textarea" rows="4" placeholder="Enter study notes, links, or code snippets..." required></textarea>
      </div>

      <div class="form-group">
        <label class="form-label">Attach File (Optional)</label>
        <input type="file" name="attachment" class="form-input">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%;">Post Note</button>
    </form>
  </div>

  <!-- Notes Listing Cards -->
  <div class="card-light" style="grid-column: span 2;">
    <div class="card-title-row">
      <h3>📖 Shared Community Notes</h3>
      <!-- Filter Form -->
      <form action="/notes" method="GET" style="display: flex; gap: 0.5rem;">
        <input type="text" name="subject" class="form-input" style="padding: 0.3rem 0.6rem; font-size: 0.85rem;" placeholder="Filter by subject..." value="<%= subjectFilter %>">
        <button type="submit" class="btn btn-secondary btn-sm">Filter</button>
      </form>
    </div>

    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      <% if (notes && notes.length > 0) { %>
        <% notes.forEach(n => { %>
          <div style="padding: 1.25rem; background: #f8fafc; border-radius: var(--radius-md); border: 1px solid #e2e8f0;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
              <div>
                <h4 style="font-family: var(--font-heading); font-size: 1.1rem; color: var(--text-primary);"><%= n.title %></h4>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.2rem;">
                  By <strong><%= n.author_name %></strong> • <%= new Date(n.created_at).toLocaleString() %>
                </div>
              </div>
              <span class="badge badge-student"><%= n.subject %></span>
            </div>

            <!-- VULNERABILITY: Stored XSS (Rendered with raw <%- n.content %> without sanitization) -->
            <div style="background: #ffffff; padding: 1rem; border-radius: var(--radius-sm); border: 1px solid #e2e8f0; color: var(--text-primary); margin-bottom: 0.75rem; font-size: 0.9rem;">
              <%- n.content %>
            </div>

            <% if (n.file_path) { %>
              <div>
                <a href="/notes/download/<%= n.id %>" class="btn btn-secondary btn-sm">📎 Download Attachment (<%= n.file_path %>)</a>
              </div>
            <% } %>
          </div>
        <% }); %>
      <% } else { %>
        <p style="color: var(--text-muted); text-align: center; padding: 2rem;">No study notes found.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
