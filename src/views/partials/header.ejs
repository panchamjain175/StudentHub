<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StudentHub - Student Records Portal</title>
  <link rel="stylesheet" href="/public/css/style.css">
  <script src="/public/js/main.js" defer></script>
</head>
<body>
  <!-- Lab Environment Warning Banner -->
  <div class="banner-warning">
    ⚠️ FOR AUTHORIZED SECURITY TRAINING IN ISOLATED LAB ENVIRONMENTS ONLY — DO NOT DEPLOY PUBLICLY
  </div>

  <div class="app-container">
    <% if (typeof user !== 'undefined' && user) { %>
      <!-- iDraft Floating Left Sidebar Navigation -->
      <aside class="sidebar">
        <div class="brand-header">
          <div class="brand-icon-box">🎓</div>
          <span class="brand-name">StudentHub</span>
        </div>

        <div class="nav-section-label">Main Menu</div>
        <ul class="sidebar-nav">
          <li>
            <a href="/dashboard" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
              <span class="nav-icon">📊</span> Dashboard
            </a>
          </li>
          <li>
            <a href="/students/profile" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'active' : '' %>">
              <span class="nav-icon">👤</span> My Profile
            </a>
          </li>
          <li>
            <a href="/records" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'records' ? 'active' : '' %>">
              <span class="nav-icon">📜</span> Academics & Grades
            </a>
          </li>
          <li>
            <a href="/vault" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'vault' ? 'active' : '' %>">
              <span class="nav-icon">🔒</span> Document Vault
            </a>
          </li>
          <li>
            <a href="/notes" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'notes' ? 'active' : '' %>">
              <span class="nav-icon">📚</span> Class Notes
            </a>
          </li>
          <li>
            <a href="/students/search" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'search' ? 'active' : '' %>">
              <span class="nav-icon">🔍</span> Student Directory
            </a>
          </li>
          <li>
            <a href="/import" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'import' ? 'active' : '' %>">
              <span class="nav-icon">📥</span> Bulk Import
            </a>
          </li>
        </ul>

        <% if (user.role === 'admin') { %>
          <div class="nav-section-label">Management</div>
          <ul class="sidebar-nav">
            <li>
              <a href="/admin/dashboard" class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'admin' ? 'active' : '' %>" style="color: var(--status-danger);">
                <span class="nav-icon">⚙️</span> Admin Panel
              </a>
            </li>
          </ul>
        <% } %>

        <div style="margin-top: auto; padding-top: 1.5rem;">
          <a href="/auth/logout" class="sidebar-link" style="color: var(--text-muted);">
            <span class="nav-icon">🚪</span> Logout
          </a>
        </div>
      </aside>

      <!-- Main Workspace Region -->
      <main class="main-content">
        <!-- Top Action Header -->
        <div class="top-header">
          <div class="greeting-text">
            <h1>Hi, <%= user.username %>!</h1>
            <p>Welcome back to your academic workspace</p>
          </div>

          <div class="top-actions">
            <a href="/notes" class="action-pill-btn">+ Create Note</a>
            <a href="/students/search" class="icon-btn" title="Search">🔍</a>
            <a href="/vault" class="icon-btn" title="Notifications">🔔</a>
            
            <div class="user-avatar-badge">
              <img src="/uploads/avatars/default.png" alt="Avatar" class="user-avatar-img">
              <span class="badge badge-<%= user.role %>"><%= user.role %></span>
            </div>
          </div>
        </div>

        <!-- DOM XSS Container Sink -->
        <div id="dom-xss-notice-container"></div>
    <% } else { %>
      <main class="main-content" style="max-width: 900px; margin: 0 auto; width: 100%;">
        <div class="top-header">
          <div class="brand-header" style="padding: 0;">
            <div class="brand-icon-box" style="width: 44px; height: 44px; font-size: 1.4rem;">🎓</div>
            <span class="brand-name" style="font-size: 1.6rem;">StudentHub</span>
          </div>

          <div class="top-actions">
            <a href="/auth/login" class="btn btn-secondary">Login</a>
            <a href="/auth/register" class="action-pill-btn">Register Student</a>
          </div>
        </div>
    <% } %>
