<%- include('partials/header') %>

<div style="max-width: 440px; margin: 2rem auto; width: 100%;">
  <div class="card-light">
    <div style="text-align: center; margin-bottom: 1.75rem;">
      <div class="brand-icon-box" style="width: 50px; height: 50px; font-size: 1.6rem; margin: 0 auto 1rem auto; border-radius: 14px;">🎓</div>
      <h2 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 800;">StudentHub Portal</h2>
      <p style="color: var(--text-secondary); font-size: 0.875rem; margin-top: 0.25rem;">Sign in to access your academic workspace</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="username">Username or ID</label>
        <input type="text" id="username" name="username" class="form-input" placeholder="e.g. alex_j or admin" required>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.75rem;">Sign In to Portal</button>
    </form>

    <div style="margin-top: 1.25rem; text-align: center; font-size: 0.85rem; color: var(--text-secondary);">
      <a href="/auth/forgot-password" style="color: var(--card-dark); font-weight: 600;">Forgot password?</a> • 
      <a href="/auth/register" style="color: var(--card-dark); font-weight: 600;">Create student account</a>
    </div>


  </div>
</div>

<%- include('partials/footer') %>
