<%- include('partials/header') %>

<div style="max-width: 460px; margin: 3rem auto;">
  <div class="card">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2>Password Reset Request</h2>
      <p style="color: var(--text-secondary); font-size: 0.9rem;">Enter your registered account email to receive a password reset link.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>

    <!-- VULNERABILITY: Password reset token leaked in response link! -->
    <% if (resetUrl) { %>
      <div style="background: rgba(124, 58, 237, 0.15); border: 1px solid var(--accent-primary); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <strong style="color: var(--accent-primary-hover);">Simulated Email Dispatch:</strong><br>
        <span style="font-size: 0.85rem; color: var(--text-secondary);">Direct Reset Link Generated:</span><br>
        <a href="<%= resetUrl %>" style="word-break: break-all; font-family: monospace; font-size: 0.85rem; color: #a7f3d0;"><%= resetUrl %></a>
      </div>
    <% } %>

    <form action="/auth/forgot-password" method="POST">
      <div class="form-group">
        <label class="form-label">Email Address</label>
        <input type="email" name="email" class="form-input" placeholder="alex.j@student.lab" required>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 1rem;">Generate Reset Link</button>
    </form>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem;">
      <a href="/auth/login">Return to Login</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
