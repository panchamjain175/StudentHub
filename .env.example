# ================================================================
# StudentHub Security Training Lab — Environment Variables Template
# Copy this to .env and fill in values for your lab environment.
# ================================================================

# Application
PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=db
DB_USER=root
DB_PASSWORD=<your_lab_db_password>
DB_NAME=studenthub
DB_PORT=3306

# Session Secret (intentionally weak for training — do NOT use real secrets)
SESSION_SECRET=<your_lab_session_secret>
